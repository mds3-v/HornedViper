{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Approval",
  "type": "object",
  "required": ["task_id", "intent_id", "mode", "risk", "decision"],
  "additionalProperties": false,
  "properties": {
    "task_id": { "type": "integer" },
    "intent_id": { "type": "integer" },
    "mode": { "enum": ["ctf", "pentest"] },
    "risk": { "enum": ["low", "medium", "high", "critical"] },
    "dangerous_actions": {
      "type": "array",
      "items": { "enum": ["delete", "modify", "credential_access"] }
    },
    "decision": { "enum": ["pending", "approved", "rejected", "expired"] },
    "decided_by": { "type": "string" },
    "reason": { "type": "string" }
  }
}
